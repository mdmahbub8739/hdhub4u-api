suspend fun extractHblinks(url: String): List<VideoLink> = withContext(Dispatchers.IO) {
    val request = Request.Builder().url(url).build()
    val doc = Jsoup.parse(client.newCall(request).execute().body?.string() ?: "")
    val results = mutableListOf<VideoLink>()

    doc.select("h3 a,h5 a,div.entry-content p a").forEach { element ->
        val href = element.attr("abs:href").ifBlank { element.attr("href") }.lowercase()
        when {
            "hubdrive" in href -> results.addAll(extractHubDrive(href))
            "hubcloud" in href -> results.addAll(extractHubCloud(href))
            "hubcdn" in href -> results.addAll(extractHubCdn(href))
            else -> results.add(VideoLink("Hblinks-Direct", href))
        }
    }
    results
}

suspend fun extractHubDrive(url: String): List<VideoLink> = withContext(Dispatchers.IO) {
    val request = Request.Builder().url(url).build()
    val doc = Jsoup.parse(client.newCall(request).execute().body?.string() ?: "")
    val href = doc.select(".btn.btn-primary.btn-user.btn-success1.m-1").attr("href")
    
    if (href.contains("hubcloud", ignoreCase = true)) {
        extractHubCloud(href)
    } else {
        listOf(VideoLink("HubDrive", href))
    }
}

suspend fun extractHubCloud(url: String): List<VideoLink> = withContext(Dispatchers.IO) {
    val uri = URI(url)
    val baseUrl = "${uri.scheme}://${uri.host}"
    
    val request1 = Request.Builder().url(url).build()
    val doc1 = Jsoup.parse(client.newCall(request1).execute().body?.string() ?: "")
    
    val href = if ("hubcloud.php" in url) {
        url
    } else {
        val raw = doc1.selectFirst("#download")?.attr("href").orEmpty()
        if (raw.startsWith("http", true)) raw else baseUrl.trimEnd('/') + "/" + raw.trimStart('/')
    }

    if (href.isBlank()) return@withContext emptyList()

    val request2 = Request.Builder().url(href).build()
    val document = Jsoup.parse(client.newCall(request2).execute().body?.string() ?: "")
    
    val size = document.selectFirst("i#size")?.text().orEmpty()
    val header = document.selectFirst("div.card-header")?.text().orEmpty()
    val results = mutableListOf<VideoLink>()

    document.select("a.btn").forEach { element ->
        val link = element.attr("href")
        val label = element.ownText().lowercase()

        when {
            "buzzserver" in label -> {
                val req3 = Request.Builder().url("$link/download").header("Referer", link).build()
                val resp = client.newCall(req3).execute()
                val dlink = resp.header("hx-redirect") ?: resp.header("HX-Redirect") ?: ""
                if (dlink.isNotBlank()) results.add(VideoLink("BuzzServer", dlink))
            }
            "pixeldra" in label || "pixelserver" in label || "pixeldrain" in label -> {
                val finalUrl = if ("download" in link) link else "https://pixeldrain.com/api/file/${link.substringAfterLast("/")}?download"
                results.add(VideoLink("Pixeldrain", finalUrl))
            }
            "fsl server" in label -> results.add(VideoLink("FSL Server", link))
            "s3 server" in label -> results.add(VideoLink("S3 Server", link))
            "fslv2" in label -> results.add(VideoLink("FSLv2", link))
            "mega server" in label -> results.add(VideoLink("Mega Server", link))
            "download file" in label -> results.add(VideoLink("Download File", link))
        }
    }
    results
}

suspend fun extractVidStack(url: String): List<VideoLink> = withContext(Dispatchers.IO) {
    val headers = mapOf("User-Agent" to "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:134.0) Gecko/20100101 Firefox/134.0")
    val hash = url.substringAfterLast("#").substringAfter("/")
    val baseurl = try { URI(url).let { "${it.scheme}://${it.host}" } } catch (e: Exception) { "https://vidstack.io" }

    val request = Request.Builder().url("$baseurl/api/v1/video?id=$hash").header("User-Agent", headers["User-Agent"]!!).build()
    val encoded = client.newCall(request).execute().body?.string()?.trim() ?: throw Exception("Empty response from VidStack")

    val key = "kiemtienmua911ca"
    val ivList = listOf("1234567890oiuytr", "0123456789abcdef")

    val decryptedText = ivList.firstNotNullOfOrNull { iv ->
        try { AesHelper.decryptAES(encoded, key, iv) } catch (_: Exception) { null }
    } ?: throw Exception("Failed to decrypt with all IVs")

    val m3u8 = Regex("\"source\":\"(.*?)\"").find(decryptedText)?.groupValues?.get(1)?.replace("\\/", "/") ?: ""
    
    listOf(VideoLink("Vidstack", m3u8.replace("https", "http"), "M3U8"))
}

suspend fun extractHubCdn(url: String): List<VideoLink> = withContext(Dispatchers.IO) {
    val request = Request.Builder().url(url).build()
    val html = client.newCall(request).execute().body?.string() ?: ""
    
    val encoded = Regex("r=([A-Za-z0-9+/=]+)").find(html)?.groups?.get(1)?.value
    if (!encoded.isNullOrEmpty()) {
        val decodedUrl = base64DecodeCustom(encoded).substringAfterLast("link=")
        return@withContext listOf(VideoLink("Hubcdn", decodedUrl))
    }
    
    val scriptText = Jsoup.parse(html).selectFirst("script:containsData(var reurl)")?.data()
    val encodedUrl2 = Regex("reurl\\s*=\\s*\"([^\"]+)\"").find(scriptText ?: "")?.groupValues?.get(1)?.substringAfter("?r=")
    val decodedUrl2 = encodedUrl2?.let { base64DecodeCustom(it) }?.substringAfterLast("link=")
    
    if (decodedUrl2 != null) {
        return@withContext listOf(VideoLink("HUBCDN", decodedUrl2))
    }
    emptyList()
}

